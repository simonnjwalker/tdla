@{ ViewData["Title"] = "Account created"; }
<div class="card account-card p-4 p-md-5 mx-auto">
    <h1 class="h3 mb-3">Your account has been created</h1>
    <p class="mb-3">New accounts registered through this website do not have access to any files while signed in until an administrator has verified them.</p>
    <p class="mb-4">Your account is awaiting verification. Once verified, access to private files will depend on the roles assigned to your account.</p>
    <a class="main-btn" href="/account/profile">Review my details</a>
    <a class="mt-3" href="/">Return to the homepage</a>
</div>
