@model RecoveryInput
@{ ViewData["Title"] = "Forgot password"; }
<div class="card account-card p-4 mx-auto"><h1 class="h3 mb-3">Forgot your password?</h1><p class="mb-4">Enter your account email address. We will email a link to confirm your request and choose a new password.</p>
<form action="/account/forgot-password" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" type="email" class="form-control mb-3" autocomplete="email" maxlength="256" required />
<button class="main-btn" type="submit">Email reset link</button>
</form><a class="mt-3" href="/account/login">Back to sign in</a></div>
