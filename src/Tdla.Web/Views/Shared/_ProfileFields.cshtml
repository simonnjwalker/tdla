<label for="FullName" class="form-label">Full name</label><input id="FullName" name="FullName" value="@Model.FullName" class="form-control mb-3" autocomplete="name" maxlength="200" required />
<label for="EmployerName" class="form-label">Firm / employer name (optional)</label><input id="EmployerName" name="EmployerName" value="@Model.EmployerName" class="form-control mb-3" autocomplete="organization" maxlength="200" />
