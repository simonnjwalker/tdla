<p class="small mb-3">Use at least 10 characters, including uppercase and lowercase letters, a number and a symbol.</p>
<label for="Password" class="form-label">Password</label><input name="Password" id="Password" type="password" class="form-control mb-3" autocomplete="new-password" minlength="10" required />
<label for="ConfirmPassword" class="form-label">Confirm password</label><input name="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control mb-4" autocomplete="new-password" minlength="10" required />
